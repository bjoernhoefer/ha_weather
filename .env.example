# Runtime ---------------------------------------------------------------
# local  = anonymous access, intended for a private subnet
# public = an API key is required for every request
HAW_DEPLOYMENT_MODE=local
# Comma separated list, required when HAW_DEPLOYMENT_MODE=public
HAW_API_KEYS=
HAW_DATABASE_PATH=data/ha_weather.sqlite3
HAW_FORECAST_DAYS=7
# Seconds a forecast is served from memory before all providers are queried again
HAW_CACHE_TTL_SECONDS=1800
# Garden watering hint: recommend watering when rain - evapotranspiration of
# today and the next two days is below -HAW_WATERING_DEFICIT_MM
HAW_WATERING_DEFICIT_MM=5

# Locations (JSON list) -------------------------------------------------
# HAW_LOCATIONS=[{"id":"vienna","name":"Vienna","latitude":48.2085,"longitude":16.3721,"timezone":"Europe/Vienna"},{"id":"porto_cristo","name":"Porto Cristo","latitude":39.5386,"longitude":3.3319,"timezone":"Europe/Madrid","aemet_municipality":"07033"}]

# Optional providers (free registration) --------------------------------
HAW_OPENWEATHERMAP_API_KEY=
HAW_WEATHERAPI_API_KEY=
# AEMET OpenData (Spain, used for Porto Cristo): https://opendata.aemet.es/centrodedescargas/altaUsuario
HAW_AEMET_API_KEY=

# Real world measurements -------------------------------------------------
# Comma separated list of enabled ObservationSource names. "open_meteo" needs
# no registration and is the default; add "home_assistant" and/or
# "elasticsearch" to also compare indoor/outdoor sensor readings.
HAW_OBSERVATION_SOURCES=open_meteo

# Home Assistant: reads indoor/outdoor sensor history via the REST history
# API using a long-lived access token (Profile -> Long-Lived Access Tokens).
# Instances and measurements can also be maintained in the web UI
# (Real world measurements). URL/token below form the instance "environment".
HAW_HOME_ASSISTANT_URL=
HAW_HOME_ASSISTANT_TOKEN=
# JSON object: location_id -> list of entity ids
HAW_HOME_ASSISTANT_INDOOR_ENTITIES={"vienna":["sensor.living_room_temperature"]}
HAW_HOME_ASSISTANT_OUTDOOR_ENTITIES={"vienna":["sensor.garden_temperature"]}
# Optional further instances and measurements (JSON lists), e.g.
# HAW_HOME_ASSISTANT_INSTANCES=[{"id":"mallorca","name":"Mallorca","url":"http://ha-mallorca.local:8123","token":"..."}]
# HAW_HOME_ASSISTANT_MEASUREMENTS=[{"instance_id":"mallorca","location_id":"porto_cristo","entity_id":"sensor.terrace_temperature","scope":"outdoor"}]
HAW_HOME_ASSISTANT_INSTANCES=[]
HAW_HOME_ASSISTANT_MEASUREMENTS=[]

# Elasticsearch (e.g. the free Elastic Cloud tier): aggregates a numeric
# temperature field per day via the Search API.
HAW_ELASTICSEARCH_URL=
HAW_ELASTICSEARCH_API_KEY=
HAW_ELASTICSEARCH_INDEX=
HAW_ELASTICSEARCH_LOCATION_FIELD=location_id
# JSON object: location_id -> name of the temperature field
HAW_ELASTICSEARCH_INDOOR_FIELDS={"vienna":"temperature_indoor"}
HAW_ELASTICSEARCH_OUTDOOR_FIELDS={"vienna":"temperature_outdoor"}

# Azure AI Foundry verification (optional) ------------------------------
HAW_AZURE_FOUNDRY_ENDPOINT=
HAW_AZURE_FOUNDRY_API_KEY=
HAW_AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini
HAW_AZURE_FOUNDRY_API_VERSION=2024-10-21
