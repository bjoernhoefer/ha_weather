# Runtime ---------------------------------------------------------------
# local  = anonymous access, intended for a private subnet
# public = an API key is required for every request
HAW_DEPLOYMENT_MODE=local
# Comma separated list, required when HAW_DEPLOYMENT_MODE=public
HAW_API_KEYS=
HAW_DATABASE_PATH=data/ha_weather.sqlite3
HAW_FORECAST_DAYS=7
# Seconds a forecast is served from memory before all providers are queried again
HAW_CACHE_TTL_SECONDS=1800

# Locations (JSON list) -------------------------------------------------
# HAW_LOCATIONS=[{"id":"vienna","name":"Vienna","latitude":48.2085,"longitude":16.3721,"timezone":"Europe/Vienna"},{"id":"porto_cristo","name":"Porto Cristo","latitude":39.5386,"longitude":3.3319,"timezone":"Europe/Madrid"}]

# Optional providers (free registration) --------------------------------
HAW_OPENWEATHERMAP_API_KEY=
HAW_WEATHERAPI_API_KEY=

# Azure AI Foundry verification (optional) ------------------------------
HAW_AZURE_FOUNDRY_ENDPOINT=
HAW_AZURE_FOUNDRY_API_KEY=
HAW_AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini
HAW_AZURE_FOUNDRY_API_VERSION=2024-10-21

# Live forecast verification (optional) ---------------------------------
# EUMETSAT cloud mask + lightning point queries (public layers need no key)
HAW_EUMETSAT_ENABLED=false
HAW_EUMETSAT_CONSUMER_KEY=
HAW_EUMETSAT_CONSUMER_SECRET=
# ha_satellite endpoint, {location_id}, {latitude}, {longitude} are replaced
HAW_SATELLITE_URL=
HAW_SATELLITE_API_KEY=
HAW_LIVE_CHECK_PAST_HOURS=3
HAW_LIVE_CHECK_AHEAD_HOURS=3
HAW_LIVE_CHECK_CONFIRMATIONS=3
HAW_LIVE_CHECK_STALE_MINUTES=60
HAW_LIVE_CHECK_HOLD_MINUTES=120
# HAW_CONSUMERS=[{"name":"garden_watering","driver":"precipitation","payload_key":"watering_impact","baseline":0,"full_adjustment":10,"full_error":10},{"name":"heating","driver":"temperature","payload_key":"heating_impact","baseline":5,"full_adjustment":10,"full_error":8}]
